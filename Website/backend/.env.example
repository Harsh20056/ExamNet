# Server Configuration
PORT=5000
NODE_ENV=development

# Firebase Admin SDK Configuration
# Option 1: Local development path to serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT=serviceAccountKey.json

# Option 2: Production / Render deployment raw JSON string
FIREBASE_SERVICE_ACCOUNT_JSON=

# AI Service Configuration
AI_API_KEY=
AI_MODEL=gpt-4o-mini
USE_CACHED_AI=true

# CORS & Networking Configuration (comma-separated origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Proctoring & Marking Calibration Rules
CALIBRATION_EVERY=15
FAST_MARKING_RATIO=0.25

# Demo Data Seeding
SEED_DEMO_PASSWORD=Demo123!
